# Olimex GateMateA1-EVB (CCGM1A1) pin constraints.
# Verified against ibex-demo-system/data/pins_gatemate.ccf,
# gatemate-olimex-playground examples, and the board schematic.
# Net names must match top_gatemate port names exactly.

# 10 MHz onboard oscillator
Net "IO_CLK"  Loc = IO_SB_A8;

# Debug UART, hardwired to the host through the onboard RP2040 (USB CDC-ACM).
# Directions are from the FPGA's point of view (rx in, tx out).
#Net "UART_RX" Loc = IO_SA_A6;
#Net "UART_TX" Loc = IO_SA_B6;

# Single user LED (active low: drive low to light).
Net "LED[0]"  Loc = IO_SB_B6;

# The board has no user buttons and reset is internal, so IO_RST_N is left
# unconstrained. LED[1..3] and SW[0..3] are unconstrained too (no board pins).
